{
  "name": "@threepenny/md2pdf",
  "version": "2.1.2",
  "description": "Markdown to beautifully styled PDF: the renderer and macOS CLI behind md2pdf.me",
  "type": "module",
  "license": "MIT",
  "author": "Threepenny Labs LLC",
  "homepage": "https://md2pdf.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbrecht/md2pdf.git"
  },
  "bin": {
    "md2pdf": "bin/md2pdf.js"
  },
  "exports": {
    ".": "./lib/render.js",
    "./render": "./lib/render.js",
    "./styles": "./lib/styles.js",
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "styles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/run.js",
    "demo": "echo 'Open http://localhost:3900/demo/' && python3 -m http.server 3900 --bind 127.0.0.1"
  },
  "dependencies": {
    "github-markdown-css": "5.9.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "katex": "^0.19.1",
    "markdown-it-texmath": "^1.0.0"
  }
}
