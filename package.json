{
  "name": "md2pdf",
  "version": "1.0.0",
  "description": "Markdown to beautifully styled PDF: the renderer and macOS CLI behind md2pdf.me",
  "type": "module",
  "license": "MIT",
  "author": "Threepenny Labs LLC",
  "homepage": "https://md2pdf.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbrecht/md2pdf.git"
  },
  "private": true,
  "bin": {
    "md2pdf": "bin/md2pdf.js"
  },
  "exports": {
